# Copy to .env and edit. Every value here is a placeholder, not a secret.
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change_me

# postgres only -- CoolMS uses jsonb and postgres-specific DQL functions.
DATABASE_URL="postgresql://coolms:coolms@postgres:5432/coolms?serverVersion=16&charset=utf8"

COOLMS_SITE_NAME="CoolMS"
COOLMS_APP_VERSION="0.0.0"
