# Copy to .env and edit. Every value here is a placeholder, not a secret.
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change_me
APP_SHARE_DIR=var/share

# postgres only -- CoolMS uses jsonb and postgres-specific DQL functions.
DATABASE_URL="postgresql://coolms:coolms@postgres:5432/coolms?serverVersion=16&charset=utf8"

# How URLs are generated outside an HTTP request -- CLI commands, emails.
DEFAULT_URI=http://localhost

# Only read if you uncomment an async transport in config/packages/messenger.yaml.
# By default every domain event is routed to `sync` and nothing is queued.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

COOLMS_SITE_NAME="CoolMS"
COOLMS_APP_VERSION="0.0.0"

# The user php-fpm serves as, which is who must be able to read a secret written
# by `coolms:install`. Only consulted when the install runs as root -- as it does
# under `docker compose exec` -- because root is never the process that reads it.
COOLMS_FILE_OWNER=www-data
